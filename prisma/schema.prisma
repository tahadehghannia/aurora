// Aurora — Prisma schema
// Postgres-backed data model for auth, content catalog, user library,
// taste signals and the recommendation engine.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Shared enums
// ---------------------------------------------------------------------------

enum ContentType {
  MOVIE
  TV_SHOW
  EPISODE
  ARTIST
  ALBUM
  SONG
}

enum InteractionType {
  VIEW
  CLICK
  HOVER
  DISMISS
  SHARE
  PLAY
}

enum FeedbackType {
  LIKE
  DISLIKE
  MORE_LIKE_THIS
  LESS_LIKE_THIS
  NOT_FOR_ME
  HIDE_CREATOR
  MUTE_GENRE
  MUTE_MOOD
  USEFUL
}

enum RecommendationSource {
  CONTENT_BASED
  COLLABORATIVE
  POPULARITY
  HYBRID
  EDITORIAL
}

// ---------------------------------------------------------------------------
// Auth (NextAuth / Auth.js — Credentials + OAuth)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  profile              Profile?
  preference           UserPreference?
  ratings              Rating[]
  savedItems           SavedItem[]
  watchHistory         WatchHistory[]
  listeningHistory     ListeningHistory[]
  collections          Collection[]
  playlists            Playlist[]
  recommendations      Recommendation[]
  searchHistory        SearchHistory[]
  genreAffinities      UserGenre[]
  artistAffinities     UserArtist[]
  interactions         UserContentInteraction[]
  feedback             UserFeedback[]
  moodWatchlists       MoodWatchlist[]
  aiArtifacts          AiArtifact[]
  aiExplanations       AiExplanation[]
  following            Follow[] @relation("Follower")
  followedBy           Follow[] @relation("Followed")

  @@map("users")
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Followed", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Profile & taste preferences
// ---------------------------------------------------------------------------

model Profile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  username            String   @unique
  bio                 String?
  // Master switch — when false, nothing below is visible on the public profile
  // regardless of the per-section flags (those only matter once this is true).
  isPublic            Boolean  @default(true)
  showRatingsPublicly     Boolean @default(true)
  showActivityPublicly    Boolean @default(true)
  showCollectionsPublicly Boolean @default(true)
  showTasteDataPublicly   Boolean @default(true)
  onboardingCompleted Boolean  @default(false)
  tasteTraits         String[] @default([]) // e.g. "Cinematic", "Experimental"
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

/// The canonical, append-only log of every correction the user makes to their
/// recommendations. UserPreference (below) stays the fast-read derived state
/// the signal engine reads; this table is what makes that state explainable
/// ("why is this muted?") and — via undoneAt — reversible.
model UserFeedback {
  id           String       @id @default(cuid())
  userId       String
  feedbackType FeedbackType
  /// Set for item-scoped feedback (Not for me, Less like this, Useful...).
  contentType  ContentType?
  contentId    String?
  /// Set for label-scoped feedback instead: the genre, mood, or tagged creator key.
  targetLabel  String?
  /// Which surface it came from — "why-this", "mood-profile", "one-pick", "settings".
  source       String
  /// Undone feedback is marked, never deleted, so the history stays auditable
  /// and an undo can be distinguished from something that never happened.
  undoneAt     DateTime?
  createdAt    DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, feedbackType])
  @@map("user_feedback")
}

model UserPreference {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  contentTypes           String[] @default([]) // movies, tv, music
  favoriteMoods          String[] @default([])
  recommendationDiversity Int     @default(50) // 0 = very safe, 100 = very adventurous
  // Explicit personalization overrides — set via "More/less like this", "Not for
  // me", "Hide creator", "Mute genre" feedback. Additive on top of the learned
  // taste signal, never replacing it. "Reset recommendation preference" clears
  // these four without touching the user's actual rating/watch/save history.
  mutedGenres            String[] @default([])
  mutedMoods             String[] @default([])
  boostedMoods           String[] @default([])
  // Creator identifiers the user asked to hide, tagged by kind so a director
  // name and an artist id can't collide: "director:<name>" / "artist:<id>".
  mutedCreators          String[] @default([])
  updatedAt              DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model UserGenre {
  id      String @id @default(cuid())
  userId  String
  genreId String
  weight  Float  @default(1)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@unique([userId, genreId])
  @@map("user_genres")
}

model UserArtist {
  id       String @id @default(cuid())
  userId   String
  artistId String
  weight   Float  @default(1)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([userId, artistId])
  @@map("user_artists")
}

// ---------------------------------------------------------------------------
// Catalog: genres, movies, tv, music
// ---------------------------------------------------------------------------

model Genre {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  movies     Movie[]
  shows      TVShow[]
  albums     Album[]
  songs      Song[]
  userGenres UserGenre[]

  @@map("genres")
}

model Movie {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  tagline       String?
  overview      String
  posterUrl     String
  backdropUrl   String?
  releaseYear   Int
  runtimeMin    Int?
  language      String   @default("en")
  director      String?
  cast          String[] @default([])
  moods         String[] @default([])
  popularity    Float    @default(0)
  communityRating Float  @default(0)
  ratingCount   Int      @default(0)
  createdAt     DateTime @default(now())

  genres Genre[]

  ratings     Rating[]
  savedItems  SavedItem[]
  watchedBy   WatchHistory[]

  @@index([popularity])
  @@index([releaseYear])
  @@map("movies")
}

model TVShow {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  tagline         String?
  overview        String
  posterUrl       String
  backdropUrl     String?
  firstAirYear    Int
  seasonCount     Int      @default(1)
  language        String   @default("en")
  creator         String?
  cast            String[] @default([])
  moods           String[] @default([])
  popularity      Float    @default(0)
  communityRating Float    @default(0)
  ratingCount     Int      @default(0)
  createdAt       DateTime @default(now())

  genres   Genre[]
  episodes Episode[]

  ratings    Rating[]
  savedItems SavedItem[]
  watchedBy  WatchHistory[]

  @@index([popularity])
  @@map("tv_shows")
}

model Episode {
  id            String   @id @default(cuid())
  slug          String   @unique
  showId        String
  title         String
  overview      String
  stillUrl      String?
  season        Int
  episodeNumber Int
  runtimeMin    Int?
  airDate       DateTime?
  communityRating Float  @default(0)
  ratingCount   Int      @default(0)

  show TVShow @relation(fields: [showId], references: [id], onDelete: Cascade)

  ratings    Rating[]
  savedItems SavedItem[]
  watchedBy  WatchHistory[]

  @@unique([showId, season, episodeNumber])
  @@map("episodes")
}

model Artist {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  bio           String?
  imageUrl      String
  genres        String[] @default([])
  moods         String[] @default([])
  popularity    Float    @default(0)
  createdAt     DateTime @default(now())

  albums Album[]
  songs  Song[]

  ratings         Rating[]
  savedItems      SavedItem[]
  userAffinities  UserArtist[]

  @@index([popularity])
  @@map("artists")
}

model Album {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  artistId        String
  coverUrl        String
  releaseYear     Int
  moods           String[] @default([])
  popularity      Float    @default(0)
  communityRating Float    @default(0)
  ratingCount     Int      @default(0)
  createdAt       DateTime @default(now())

  artist Artist  @relation(fields: [artistId], references: [id], onDelete: Cascade)
  genres Genre[]
  songs  Song[]

  ratings          Rating[]
  savedItems       SavedItem[]
  listeningHistory ListeningHistory[]

  @@index([popularity])
  @@map("albums")
}

model Song {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  artistId        String
  albumId         String?
  durationSec     Int
  moods           String[] @default([])
  popularity      Float    @default(0)
  communityRating Float    @default(0)
  ratingCount     Int      @default(0)
  createdAt       DateTime @default(now())

  artist Artist  @relation(fields: [artistId], references: [id], onDelete: Cascade)
  album  Album?  @relation(fields: [albumId], references: [id], onDelete: SetNull)
  genres Genre[]

  ratings          Rating[]
  savedItems       SavedItem[]
  listeningHistory ListeningHistory[]
  playlistItems    PlaylistItem[]

  @@index([popularity])
  @@map("songs")
}

// ---------------------------------------------------------------------------
// User activity: ratings, library, history
// ---------------------------------------------------------------------------

model Rating {
  id          String      @id @default(cuid())
  userId      String
  contentType ContentType
  contentId   String
  score       Float // 0.5–5, half-star increments
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  movie   Movie?   @relation(fields: [movieId], references: [id], onDelete: Cascade)
  movieId String?
  show    TVShow?  @relation(fields: [showId], references: [id], onDelete: Cascade)
  showId  String?
  episode Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  episodeId String?
  artist  Artist?  @relation(fields: [artistId], references: [id], onDelete: Cascade)
  artistId String?
  album   Album?   @relation(fields: [albumId], references: [id], onDelete: Cascade)
  albumId String?
  song    Song?    @relation(fields: [songId], references: [id], onDelete: Cascade)
  songId  String?

  @@unique([userId, contentType, contentId])
  @@index([contentType, contentId])
  @@map("ratings")
}

model SavedItem {
  id          String      @id @default(cuid())
  userId      String
  contentType ContentType
  contentId   String
  createdAt   DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  movie   Movie?  @relation(fields: [movieId], references: [id], onDelete: Cascade)
  movieId String?
  show    TVShow? @relation(fields: [showId], references: [id], onDelete: Cascade)
  showId  String?
  episode Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  episodeId String?
  artist  Artist? @relation(fields: [artistId], references: [id], onDelete: Cascade)
  artistId String?
  album   Album?  @relation(fields: [albumId], references: [id], onDelete: Cascade)
  albumId String?
  song    Song?   @relation(fields: [songId], references: [id], onDelete: Cascade)
  songId  String?

  @@unique([userId, contentType, contentId])
  @@index([userId])
  @@map("saved_items")
}

model WatchHistory {
  id          String      @id @default(cuid())
  userId      String
  contentType ContentType
  contentId   String
  progressPct Int         @default(0)
  watchedAt   DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  movie   Movie?   @relation(fields: [movieId], references: [id], onDelete: Cascade)
  movieId String?
  show    TVShow?  @relation(fields: [showId], references: [id], onDelete: Cascade)
  showId  String?
  episode Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  episodeId String?

  @@index([userId, watchedAt])
  @@map("watch_history")
}

model ListeningHistory {
  id          String      @id @default(cuid())
  userId      String
  contentType ContentType
  contentId   String
  msPlayed    Int         @default(0)
  playedAt    DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  song    Song?  @relation(fields: [songId], references: [id], onDelete: Cascade)
  songId  String?
  album   Album? @relation(fields: [albumId], references: [id], onDelete: Cascade)
  albumId String?

  @@index([userId, playedAt])
  @@map("listening_history")
}

model UserContentInteraction {
  id              String           @id @default(cuid())
  userId          String
  contentType     ContentType
  contentId       String
  interactionType InteractionType
  weight          Float            @default(1)
  createdAt       DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([contentType, contentId])
  @@map("user_content_interactions")
}

// ---------------------------------------------------------------------------
// Collections & playlists
// ---------------------------------------------------------------------------

model Collection {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CollectionItem[]

  @@map("collections")
}

model CollectionItem {
  id           String      @id @default(cuid())
  collectionId String
  contentType  ContentType
  contentId    String
  position     Int         @default(0)
  addedAt      DateTime    @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, contentType, contentId])
  @@map("collection_items")
}

model Playlist {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  coverUrl    String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items PlaylistItem[]

  @@map("playlists")
}

model PlaylistItem {
  id         String   @id @default(cuid())
  playlistId String
  songId     String
  position   Int      @default(0)
  addedAt    DateTime @default(now())

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  song     Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([playlistId, songId])
  @@map("playlist_items")
}

// ---------------------------------------------------------------------------
// Recommendations & search
// ---------------------------------------------------------------------------

model Recommendation {
  id          String               @id @default(cuid())
  userId      String
  contentType ContentType
  contentId   String
  score       Float
  source      RecommendationSource
  reason      String?
  createdAt   DateTime             @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentType, contentId])
  @@index([userId, score])
  @@map("recommendations")
}

model SearchHistory {
  id        String   @id @default(cuid())
  userId    String
  query     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("search_history")
}

/// Reason vocabulary for why a title was placed in a mood watchlist.
enum MoodReasonType {
  MOOD_MATCH
  TASTE_MATCH
  RECENT_INTEREST
  CREATOR_MATCH
  GENRE_MATCH
  CONTEXT_MATCH
  EXPLORATION
  RUNTIME_MATCH
}

/// A watchlist generated from a natural-language mood request.
///
/// The structured columns are the source of truth, not the generated prose:
/// `parsedIntent` stores the validated intent the list was built from, so a
/// list can be audited, regenerated, or refined later without re-parsing the
/// original sentence. `aiCurated` records whether a model actually wrote the
/// copy, which keeps the UI's provenance labelling honest.
model MoodWatchlist {
  id              String   @id @default(cuid())
  userId          String
  title           String
  description     String
  whyThisList     String
  prompt          String
  /// Validated MoodIntent — the machine-readable version of the request.
  parsedIntent    Json
  exploration     String   @default("balanced")
  personalization String   @default("general")
  aiCurated       Boolean  @default(false)
  /// Provider model that curated this list, when one did.
  modelVersion    String?
  /// Bumped when the prompt design changes, so old lists stay interpretable.
  promptVersion   String   @default("1")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  items MoodWatchlistItem[]

  @@index([userId, createdAt])
  @@map("mood_watchlists")
}

model MoodWatchlistItem {
  id          String         @id @default(cuid())
  watchlistId String
  contentType ContentType
  contentId   String
  position    Int
  reason      String
  reasonType  MoodReasonType @default(GENRE_MATCH)
  createdAt   DateTime       @default(now())

  watchlist MoodWatchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, contentType, contentId])
  @@index([watchlistId, position])
  @@map("mood_watchlist_items")
}

/// The personalized artifacts an AI model writes copy for.
enum AiArtifactKind {
  IDENTITY
  DNA
  MOOD_PROFILE
  TASTE_EVOLUTION
}

/// Cache for AI-generated prose about a user's taste (§22, §23).
///
/// Deliberately one table rather than a parallel schema of EntertainmentTrait /
/// MoodProfile / TasteEvolution rows. Everything queryable — genres, moods,
/// counts, ratings, history — is already stored in structured form and remains
/// the source of truth; what lives here is only the generated *wording* derived
/// from it, which nothing queries by field. Modelling it twice would create a
/// second, staler answer to questions the real tables already answer.
///
/// The version columns are what make regeneration decidable: `dataVersion`
/// fingerprints the taste inputs, so the cache self-invalidates when a user's
/// behaviour moves, and `modelVersion`/`promptVersion` allow a targeted
/// refresh after a model or prompt change.
model AiArtifact {
  id            String         @id @default(cuid())
  userId        String
  kind          AiArtifactKind
  /// The validated, schema-checked payload for this artifact kind.
  payload       Json
  /// Provider model that produced it, e.g. "openai/gpt-oss-20b".
  modelVersion  String
  promptVersion String
  /// Fingerprint of the taste inputs behind it — see buildDataVersion().
  dataVersion   String
  generatedAt   DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
  @@index([userId, kind])
  @@map("ai_artifacts")
}

/// A cached AI-worded explanation for one recommendation (§24, §26).
///
/// Separate from AiArtifact because the grain is different: one row per user
/// per title, rather than one per user per artifact kind. Without this, "Why
/// this?" fires a model call on every detail-page view and exhausts a shared
/// quota that the identity and DNA generations also depend on.
model AiExplanation {
  id            String      @id @default(cuid())
  userId        String
  contentType   ContentType
  contentId     String
  /// The generated sentence.
  text          String
  modelVersion  String
  promptVersion String
  /// Taste fingerprint at generation time — see buildDataVersion().
  dataVersion   String
  generatedAt   DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentType, contentId])
  @@index([userId, generatedAt])
  @@map("ai_explanations")
}
