# Database
DATABASE_URL="postgresql://aurora:aurora@localhost:5432/aurora?schema=public"

# NextAuth
AUTH_SECRET="replace-with-a-random-32-byte-secret"
AUTH_URL="http://localhost:3000"

# Optional: Google OAuth
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Optional: external content providers (server-side only, never exposed to the client)
# TMDB_API_KEY is the v4 "API Read Access Token" (not the shorter v3 API key) from
# https://www.themoviedb.org/settings/api — used as a Bearer token. Without it, movies
# fall back to Aurora's built-in fictional catalog (see src/lib/content/providers/index.ts).
TMDB_API_KEY=""
# Spotify Client Credentials flow — https://developer.spotify.com/dashboard. Without it,
# music falls back to iTunes Search (keyless, always live) then the fictional catalog.
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# Optional: AI provider (server-side only — never NEXT_PUBLIC_*). Aurora's taste
# and mood features run on deterministic logic and stay fully functional without
# this; a key only lets a model read the request and word the results. Retrieval,
# ranking and diversity are always Aurora's own.
#
# Recommended free option: Groq (console.groq.com/keys) — no credit card, and it
# does not train on API prompts on any tier, which matters because Aurora sends
# real user taste data. Google's free tier DOES allow training on free-tier
# prompts; prefer its paid tier or Vertex AI if you go that route.
#
# Verify before relying on it: `npm run ai:verify`
AI_API_KEY=""

# Only needed for a self-hosted gateway or proxy, or a key whose prefix Aurora
# can't recognise — otherwise the provider is detected from the key itself.
# AI_PROVIDER selects the wire format; AI_BASE_URL points it at the host.
# AI_PROVIDER="openai"          # anthropic | openai | google | groq | mistral | deepseek
# AI_BASE_URL="https://my-gateway.internal/v1"
# AI_MODEL="llama-3.3-70b-versatile"
