# Database
DATABASE_URL="postgresql://aurora:aurora@localhost:5432/aurora?schema=public"

# NextAuth
AUTH_SECRET="replace-with-a-random-32-byte-secret"
AUTH_URL="http://localhost:3000"

# Optional: Google OAuth
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Optional: external content providers (server-side only, never exposed to the client)
# TMDB_API_KEY is the v4 "API Read Access Token" (not the shorter v3 API key) from
# https://www.themoviedb.org/settings/api — used as a Bearer token. Without it, movies
# fall back to Aurora's built-in fictional catalog (see src/lib/content/providers/index.ts).
TMDB_API_KEY=""
# Spotify Client Credentials flow — https://developer.spotify.com/dashboard. Without it,
# music falls back to iTunes Search (keyless, always live) then the fictional catalog.
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
